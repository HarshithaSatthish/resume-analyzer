# Application

APP_NAME=AI Resume Analyzer

APP_ENV=development

DEBUG=true



# MongoDB (use MongoDB Atlas connection string in production)

MONGODB_URL=mongodb://localhost:27017

DATABASE_NAME=resume_analyzer

MONGODB_MAX_POOL_SIZE=50

MONGODB_MIN_POOL_SIZE=5

MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

MONGODB_CONNECT_TIMEOUT_MS=5000



# JWT Authentication (use a long random secret in production)

JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

JWT_ALGORITHM=HS256

JWT_EXPIRE_MINUTES=1440



# Google Gemini AI

GEMINI_API_KEY=your-gemini-api-key-here

GEMINI_MODEL=gemini-1.5-flash



# File Upload (use /var/data/uploads and /var/data/reports on Render with persistent disk)

MAX_UPLOAD_SIZE_MB=5

UPLOAD_DIR=uploads

REPORTS_DIR=reports



# CORS (comma-separated origins — add your Vercel URL in production)

CORS_ORIGINS=http://localhost:5173,http://localhost:3000



# spaCy model

SPACY_MODEL=en_core_web_sm

